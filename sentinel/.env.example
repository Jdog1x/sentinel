LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o
FLASK_SECRET_KEY=change-this-to-a-random-secret
FLASK_PORT=5000
FLASK_DEBUG=false
# Comma-separated CORS allowlist for the API; "*" allows any origin (dev only).
CORS_ORIGINS=*
# Verify TLS certs on HTTP probes. Off by default so the scanner can reach
# targets with self-signed or misconfigured certificates.
HTTP_VERIFY_TLS=false
DATABASE_URL=sqlite:///sentinel.db
REPORTS_OUTPUT_DIR=./reports
