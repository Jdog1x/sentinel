LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o

# --- Web API ---
# Leave FLASK_SECRET_KEY unset to auto-generate a strong random key per process;
# set a fixed value in production so sessions survive restarts.
FLASK_SECRET_KEY=
# Host to bind. Defaults to loopback so the API is NOT exposed on the network.
# Set to 0.0.0.0 only when you intend to expose it (and have set SENTINEL_API_KEY).
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# --- API authentication ---
# When set, every /api/* request (except /api/health) must send the key via
# "X-API-Key: <key>" or "Authorization: Bearer <key>". Leave empty to disable
# auth for local development.
SENTINEL_API_KEY=

# Comma-separated CORS allowlist for the API. Defaults to the local dev
# frontend. Use "*" to allow any origin (development only — not recommended).
CORS_ORIGINS=http://localhost:3000

# Verify TLS certs on HTTP probes. ON by default: a scanner that ignores cert
# errors hides real findings. Disable per-engagement only when you specifically
# need to fingerprint hosts with broken certs.
HTTP_VERIFY_TLS=true

# --- Target authorization / SSRF controls ---
# Block scanning of private/loopback/link-local/reserved IPs unless set to true
# (e.g. for authorized internal engagements).
ALLOW_PRIVATE_TARGETS=false
# Optional comma-separated allowlist. When non-empty, ONLY these hosts/domains
# (and their subdomains) may be scanned. Example: example.com,test.internal
TARGET_ALLOWLIST=

# --- Resource limits ---
# Maximum scans running concurrently; further requests queue.
MAX_CONCURRENT_SCANS=2
# Max scan-creation requests per minute per client IP.
SCAN_RATE_LIMIT_PER_MINUTE=10

DATABASE_URL=sqlite:///sentinel.db
REPORTS_OUTPUT_DIR=./reports
