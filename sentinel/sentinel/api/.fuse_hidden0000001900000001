"""
sentinel/api/app.py
Flask REST API — scans, findings, AI chat, report download.
"""
from __future__ import annotations

from pathlib import Path

from flask import Flask, jsonify, request, send_file
from flask_cors import CORS

from sentinel.core.authorization import TargetNotAuthorized, authorize_target
from sentinel.core.config import config
from sentinel.core.jobs import submit_scan
from sentinel.core.models import Report, Scan, ScanStatus, SessionLocal, init_db
from sentinel.llm.provider import get_provider
from sentinel.reports.pdf_generator import generate as generate_pdf
from sentinel.api.security import RateLimiter, api_key_valid, extract_api_key

# Endpoints reachable without an API key even when auth is enabled.
_PUBLIC_PATHS = {"/api/health"}


def create_app() -> Flask:
    app = Flask(__name__)
    app.secret_key = config.flask_secret_key
    # CORS_ORIGINS is a comma-separated allowlist; "*" allows any origin (dev only).
    origins = "*" if config.cors_origins.strip() == "*" else [
        o.strip() for o in config.cors_origins.split(",") if o.strip()
    ]
    CORS(app, resources={r"/api/*": {"origins": origins}})
    init_db()

    scan_limiter = RateLimiter(config.scan_rate_limit_per_minute)

    @app.before_request
    def _authenticate():
        # Let CORS preflight through and skip explicitly public endpoints.
        if request.method == "OPTIONS" or request.path in _PUBLIC_PATHS:
            return None
        if not request.path.startswith("/api/"):
            return None
        if not api_key_valid(extract_api_key(request.headers)):
            return jsonify({"error": "unauthorized"}), 401
        return None

    @app.get("/api/scans")
    def list_scans():
        db = SessionLocal()
        scans = db.query(Scan).order_by(Scan.created_at.desc()).all()
        result = [s.to_dict() for s in scans]
        db.close()
        return jsonify(result)

    @app.post("/api/scans")
    def create_scan():
        if not scan_limiter.allow(request.remote_addr or "unknown"):
            return jsonify({"error": "rate limit exceeded, try again shortly"}), 429
        data    = request.get_json(force=True)
        target  = data.get("target", "").strip()
        backend = data.get("llm_backend")
        fast    = data.get("fast", False)
        if not target:
            return jsonify({"error": "target is required"}), 400
        # Reject unauthorized targets up front, before creating any DB row.
        try:
            authorize_target(target)
        except TargetNotAuthorized as exc:
            return jsonify({"error": str(exc)}), 403
        db   = SessionLocal()
        scan = Scan(target=target, status=ScanStatus.PENDING, llm_backend=backend)
        db.add(scan)
        db.commit()
        db.refresh(scan)
        scan_dict = scan.to_dict()
        db.close()

        # Run on the bounded worker pool instead of an unbounded raw thread.
        submit_scan(target, backend=backend, fast=fast)
        return jsonify(scan_dict), 202

    @app.get("/api/scans/<scan_id>")
    def get_scan(scan_id: str):
        db = SessionLocal()
        s = db.query(Scan).filter(Scan.id == scan_id).first()
        if not s:
            db.close()
            return jsonify({"error": "scan not found"}), 404
        result = s.to_dict()
        db.close()
        return jsonify(result)

    @app.delete("/api/scans/<scan_id>")
    def delete_scan(scan_id: str):
        db   = SessionLocal()
        scan = db.query(Scan).filter(Scan.id == scan_id).first()
        if not scan:
            db.close()
            return jsonify({"error": "not found"}), 404
        db.delete(scan)
        db.commit()
        db.close()
        return jsonify({"deleted": scan_id})

    @app.post("/api/scans/<scan_id>/report")
    def create_report(scan_id: str):
        db = SessionLocal()
        s = db.query(Scan).filter(Scan.id == scan_id).first()
        if not s:
            db.close()
            return jsonify({"error": "scan not found"}), 404
        try:
            pdf_path = generate_pdf(s)
            report   = Report(scan_id=scan_id, file_path=str(pdf_path))
            db.add(report)
            db.commit()
            db.refresh(report)
            report_dict = report.to_dict()
        except Exception as exc:
            db.close()
            return jsonify({"error": str(exc)}), 500
        db.close()
        return jsonify(report_dict), 201

    @app.get("/api/reports/<report_id>/download")
    def download_report(report_id: str):
        db     = SessionLocal()
        report = db.query(Report).filter(Report.id == report_id).first()
        db.close()
        if not report:
            return jsonify({"error": "not found"}), 404
        p = Path(report.file_path)
        if not p.exists():
            return jsonify({"error": "file missing"}), 404
        return send_file(str(p), as_attachment=True, download_name=p.name)

    @app.post("/api/chat")
    def chat():
        data     = request.get_json(force=True)
        messages = data.get("messages", [])
        scan_id  = data.get("scan_id")
        backend  = data.get("llm_backend")
        if not messages:
            return jsonify({"error": "messages are required"}), 400